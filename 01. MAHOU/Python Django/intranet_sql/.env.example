# Copiar a .env. setup.ps1 genera una clave aleatoria si no hay .env.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
HTTPS_ENABLED=false
TRUST_PROXY_HEADERS=false

# Activar tras comprobar el DSN de sistema con la cuenta que ejecutará el worker.
EXTERNAL_DB_ENABLED=false
XGA_DSN=XGA_PROD
XGA_DATABASE=XGA
XGA_DRIVER=ODBC Driver 18 for SQL Server
XGA_EXTRA_PARAMS=Trusted_Connection=yes;Encrypt=yes;TrustServerCertificate=no;
# Límite por sentencia SQL (segundos). El tiempo total de exportación puede ser mayor.
XGA_QUERY_TIMEOUT=1800
REPORT_MAX_ROWS=1000000
# APP_DB_PATH=C:/IntranetSQL/data/db.sqlite3
# REPORT_ROOT=C:/IntranetSQL/data/reports

# file = .eml de prueba, sin envíos. smtp o graph = envío real.
MAIL_PROVIDER=file
MAIL_FROM=intranet@example.invalid
MAIL_MAX_ATTACHMENT_BYTES=2000000
SMTP_HOST=
SMTP_PORT=25
SMTP_TLS=false
SMTP_SSL=false
SMTP_USER=
SMTP_PASSWORD=

GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=

# Dashboard Mahou (conexión independiente del resto de consultas)
MAHOU_DB_ENABLED=false
MAHOU_DSN=conexion replicada
MAHOU_DATABASE=XGA
MAHOU_DRIVER=ODBC Driver 18 for SQL Server
MAHOU_EXTRA_PARAMS=Trusted_Connection=yes;Encrypt=yes;TrustServerCertificate=no;ApplicationIntent=ReadOnly;
MAHOU_QUERY_TIMEOUT=300
# Usuario Django activo y con acceso a ambas consultas; vacío desactiva la actualización automática.
MAHOU_AUTO_REFRESH_USER=
MAHOU_REFRESH_SECONDS=900
MAHOU_MAX_ROWS=20000
